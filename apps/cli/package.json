{
  "name": "issueforge",
  "version": "0.1.0-alpha.3",
  "type": "module",
  "bin": {
    "issueforge": "dist/main.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc --build && tsup",
    "typecheck": "tsc --build --emitDeclarationOnly false",
    "dev": "node src/main.ts",
    "prepack": "node ./scripts/sync-package-docs.mjs",
    "prepublishOnly": "pnpm -w check"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "pino": "^10.3.1",
    "execa": "^10.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@issueforge/adapters": "workspace:*",
    "@issueforge/contracts": "workspace:*",
    "@issueforge/core": "workspace:*",
    "publint": "^0.3.14"
  },
  "description": "Local-first GitHub IssueOps supervisor for coding-agent harnesses",
  "keywords": [
    "github",
    "issueops",
    "coding-agent",
    "claude-code",
    "automation",
    "self-hosted-runner",
    "cli"
  ],
  "license": "Apache-2.0",
  "author": "tranminhquang",
  "homepage": "https://github.com/vietnamesekid/issueforge#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vietnamesekid/issueforge.git",
    "directory": "apps/cli"
  },
  "bugs": {
    "url": "https://github.com/vietnamesekid/issueforge/issues"
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha",
    "registry": "https://registry.npmjs.org/"
  }
}
