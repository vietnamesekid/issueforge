{
  "name": "@issueforge",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "build": "tsc --build && pnpm --filter issueforge exec tsup",
    "clean": "rm -rf packages/*/dist apps/*/dist .tsbuild && find . -name 'tsconfig.tsbuildinfo' -not -path '*/node_modules/*' -delete",
    "typecheck": "tsc --build",
    "test": "pnpm build && vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm --filter issueforge exec publint",
    "test:unit": "vitest run",
    "build:clean": "pnpm clean && pnpm build",
    "test:coverage": "vitest run --coverage",
    "changeset": "changeset",
    "ci:version": "changeset version && pnpm install --no-frozen-lockfile",
    "ci:release": "pnpm build && node scripts/publish.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.17.0",
    "jiti": "^2.7.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8",
    "yaml": "^2.9.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
